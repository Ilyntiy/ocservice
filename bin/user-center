#!/bin/bash
# user-center — view and manage VPN users — https://github.com/Ilyntiy/ocservice

DIR=$(dirname "$(realpath "$0")")
[[ -f $DIR/ocservice.conf ]] || { echo "Error: $DIR/ocservice.conf not found. Run install.sh first."; exit 1; }
# shellcheck source=/dev/null
source "$DIR/ocservice.conf"
# shellcheck source=ocnames
source "$DIR/ocnames" || exit 1

EDITOR_CMD=${VISUAL:-${EDITOR:-$(command -v nano || command -v vi)}}
G=$'\033[0;32m'; Y=$'\033[0;33m'; R=$'\033[0;31m'; N=$'\033[0m'

occtl() { sudo -n "$OCCTL" -n "$@"; }

# occtl prints its version to stderr
version=$("$OCCTL" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
if [[ -n $version && $(printf '%s\n' 1.4.2 "$version" | sort -V | head -n1) == 1.4.2 ]]; then
  CAN_TERMINATE=1
else
  CAN_TERMINATE=0
fi

epoch_days() {
  local y=$((10#${1:0:4})) m=$((10#${1:5:2})) d=$((10#${1:8:2})) era yoe doy
  (( m <= 2 )) && y=$((y - 1))
  era=$((y / 400)); yoe=$((y - era * 400))
  doy=$(( (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1 ))
  EPOCH_DAYS=$(( era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468 ))
}

kick() {
  if (( CAN_TERMINATE )); then occtl terminate user "$1"; else occtl disconnect user "$1"; fi
}

valid_certs() {
  awk -F'\t' '$1 == "V" { s = $NF; sub(/.*CN=/, "", s); sub(/\/.*/, "", s); print s }' \
    "$EASYRSA_DIR/pki/index.txt" 2>/dev/null | sort
}

is_client_cert() {
  local eku
  eku=$("$OPENSSL" x509 -in "$EASYRSA_DIR/pki/issued/$1.crt" -noout -text 2>/dev/null \
    | awk '/X509v3 Extended Key Usage/ {getline; print; exit}')
  [[ $eku == *"TLS Web Client Authentication"* && $eku != *"TLS Web Server Authentication"* ]]
}

cert_users() {
  local user
  while read -r user; do
    [[ -n $user ]] || continue
    if [[ -n ${cache_end[$user]+x} ]] || is_client_cert "$user"; then echo "$user"; fi
  done < <(valid_certs)
}

rebuild_cert_cache() {
  local tmp user raw start end
  echo -n "Rebuilding certificate cache..."
  tmp=$(mktemp "$CERT_CACHE_FILE.XXXXXX")
  while read -r user; do
    [[ -n $user && -f $EASYRSA_DIR/pki/issued/$user.crt ]] || continue
    is_client_cert "$user" || continue
    raw=$("$OPENSSL" x509 -in "$EASYRSA_DIR/pki/issued/$user.crt" -noout -startdate -enddate 2>/dev/null)
    start=$(date -d "$(sed -n 's/^notBefore=//p' <<< "$raw")" +%Y-%m-%d)
    end=$(date -d "$(sed -n 's/^notAfter=//p' <<< "$raw")" +%Y-%m-%d)
    echo "$user|$start|$end" >> "$tmp"
    [[ -f $CONFIG_PER_USER/$user ]] || write_config_per_user "$user"
  done < <(valid_certs)
  mv -- "$tmp" "$CERT_CACHE_FILE"
  echo " done."
}

remove_line() {
  local file=$1 tmp
  [[ -f $file ]] || return 0
  tmp=$(mktemp "$file.XXXXXX")
  awk -v k="$2" -v mode="$3" '(mode == "cache") ? index($0, k "|") != 1 : $0 != k' "$file" > "$tmp"
  chmod --reference="$file" -- "$tmp"
  mv -- "$tmp" "$file"
}

delete_user() {
  local user=$1 type=$2 ip=$3 confirm
  read -rp "Delete '$user'? This cannot be undone. (y/n): " confirm
  [[ $confirm == [yY] ]] || { echo "Cancelled."; return; }

  if [[ $type == cert ]]; then
    if ! is_client_cert "$user"; then
      echo "❌ '$user' is not a client certificate — refusing to revoke it here."
      return 1
    fi
    if ! ( cd "$EASYRSA_DIR" && ./easyrsa revoke "$user" && ./easyrsa gen-crl ); then
      echo "❌ Revocation failed — user not deleted."
      return 1
    fi
    occtl reload >/dev/null || echo "⚠️  occtl reload failed — the new CRL applies when ocserv rereads it."
    rm -f -- "$VPN_CLIENTS_DIR/$user.p12"
    remove_line "$CERT_CACHE_FILE" "$user" cache
  else
    if ! "$OCPASSWD" -d -c "$USER_FILE" "$user"; then
      echo "❌ ocpasswd failed — user not deleted."
      return 1
    fi
  fi

  [[ -n $ip ]] && kick "$user"
  rm -f -- "$CONFIG_PER_USER/$user"
  remove_line "$NAMES_USED_FILE" "$user" exact
  echo "[deleted] $(date '+%Y-%m-%d %H:%M') | $user | $type" >> "$USER_HISTORY"
  echo "✅ User '$user' deleted."
}

declare -A user_ip ban max_sessions cache_start cache_end is_cert
declare -a all_users all_types

while read -r id user _ ip _; do
  [[ $id =~ ^[0-9]+$ && $user != "(none)" ]] && user_ip[$user]=$ip
done < <(occtl show users 2>/dev/null)

while read -r ip score; do
  [[ $ip =~ ^[0-9a-fA-F.:]+$ && $score =~ ^[0-9]+$ ]] && ban[$ip]=$score
done < <(occtl show ip ban points 2>/dev/null)

for f in "$CONFIG_PER_USER"/*; do
  [[ -f $f ]] || continue
  v=$(awk -F'=' '/^[[:space:]]*max-same-clients[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2}' "$f")
  max_sessions[${f##*/}]=${v:--}
done

if [[ -f $CERT_CACHE_FILE ]]; then
  while IFS='|' read -r u s e; do
    [[ -n $u ]] || continue
    cache_start[$u]=$s
    cache_end[$u]=$e
  done < "$CERT_CACHE_FILE"
fi

clear
echo "================ ⚙️  User Management Center =================="
printf "👥 Active connections: %s\n\n" "${#user_ip[@]}"

today=$(( $(date +%s) / 86400 ))
index=1
table=""

row_common() {
  local user=$1 ip=${user_ip[$1]} pts name
  pts=0
  [[ -n $ip ]] && pts=${ban[$ip]:-0}
  name=$user
  (( pts >= 80 )) && name="$user 🚫"
  (( pts == 0 )) && pts="-"
  if [[ -n $ip ]]; then ROW_ONLINE="🟢"; else ROW_ONLINE="⚪"; fi
  ROW_NAME=$name
  ROW_BAN=$pts
  ROW_MAX=${max_sessions[$user]:--}
}

if [[ $AUTH_MODE != plain ]]; then
  cert_list=$(cert_users)
  while read -r user; do
    [[ -n $user ]] || continue
    all_users+=("$user"); all_types+=("cert"); is_cert[$user]=1
    row_common "$user"
    start=${cache_start[$user]:--}
    end=${cache_end[$user]:--}
    left="-"
    if [[ $end =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      epoch_days "$end"
      left=$(( EPOCH_DAYS - today ))
    fi
    left_fmt=$(printf '%-4s' "$left")
    if [[ $left =~ ^-?[0-9]+$ ]]; then
      if   (( left <= 10 )); then left_fmt=$R$left_fmt$N
      elif (( left <= 30 )); then left_fmt=$Y$left_fmt$N
      else                        left_fmt=$G$left_fmt$N
      fi
    fi
    table+=$(printf '%-3s %-2s %-27s │ %-4s │ %-10s │ %-10s │ %s │ %-3s' \
      "$index" "$ROW_ONLINE" "$ROW_NAME" "$ROW_BAN" "$start" "$end" "$left_fmt" "$ROW_MAX")$'\n'
    index=$((index + 1))
  done <<< "$cert_list"
fi

if [[ $AUTH_MODE != cert ]]; then
  while IFS=: read -r user _; do
    [[ -n $user ]] || continue
    [[ -n ${is_cert[$user]:-} ]] && continue
    all_users+=("$user"); all_types+=("login")
    row_common "$user"
    if [[ $AUTH_MODE == plain ]]; then
      table+=$(printf '%-3s %-2s %-27s │ %-4s │ %-3s' \
        "$index" "$ROW_ONLINE" "$ROW_NAME" "$ROW_BAN" "$ROW_MAX")$'\n'
    else
      table+=$(printf '%-3s %-2s %-27s │ %-4s │ %-10s │ %-10s │ %-4s │ %-3s' \
        "$index" "$ROW_ONLINE" "$ROW_NAME" "$ROW_BAN" "-" "-" "-" "$ROW_MAX")$'\n'
    fi
    index=$((index + 1))
  done < <(sort -t: -k1,1 "$USER_FILE" 2>/dev/null)
fi

if [[ $AUTH_MODE == plain ]]; then
  printf '%-3s %-2s %-27s │ %-4s │ %-3s\n' "#" "" "Name" "BP" "MAX"
  sep="------------------------------------------------------------"
else
  printf '%-3s %-2s %-27s │ %-4s │ %-10s │ %-10s │ %-4s │ %-3s\n' "#" "" "Name" "BP" "Created" "Expires" "Left" "MAX"
  sep="-----------------------------------------------------------------------------------------------"
fi
echo "$sep"
printf '%s' "$table"
echo "$sep"
echo "  0 — View user-history.log"
[[ $AUTH_MODE != plain ]] && echo "  r — Rebuild certificate cache"
echo "  q — Quit"
echo
read -rp "Select user by number (or 0/r/q): " choice

case $choice in
  q)
    exit 0
    ;;
  r)
    [[ $AUTH_MODE != plain ]] && rebuild_cert_cache
    read -rp "Press Enter to continue..." _
    exec "$0"
    ;;
  0)
    echo "=========== User action log ==========="
    if [[ -s $USER_HISTORY ]]; then cat -- "$USER_HISTORY"; else echo "(empty)"; fi
    echo "======================================="
    ;;
  *)
    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#all_users[@]} )); then
      user=${all_users[choice-1]}
      type=${all_types[choice-1]}
      ip=${user_ip[$user]}
      pts=0
      [[ -n $ip ]] && pts=${ban[$ip]:-0}

      echo
      echo "📊 Connection info:"
      if [[ -n $ip ]]; then occtl show user "$user"; else echo "  (user is not connected)"; fi
      echo
      echo "🔧 Actions for: $user"
      echo "  1 — Edit config (config-per-user)"
      echo "  2 — Delete user"
      if [[ -n $ip ]]; then
        if (( CAN_TERMINATE )); then
          echo "  3 — Kick user and invalidate session (IP: $ip)"
        else
          echo "  3 — Kick user (IP: $ip) ⚠️  ocserv 1.4.2+ also invalidates the session"
        fi
        (( pts > 0 )) && echo "  4 — Reset ban points (current: $pts, IP: $ip)"
      fi
      echo "  0 — Back"
      read -rp "Select action: " action

      case $action in
        1)
          [[ -f $CONFIG_PER_USER/$user ]] || write_config_per_user "$user"
          "$EDITOR_CMD" "$CONFIG_PER_USER/$user"
          ;;
        2)
          delete_user "$user" "$type" "$ip"
          ;;
        3)
          if [[ -z $ip ]]; then
            echo "User is not connected."
          else
            read -rp "Kick '$user'? (y/n): " confirm
            if [[ $confirm == [yY] ]]; then
              if kick "$user"; then
                echo "[kicked] $(date '+%Y-%m-%d %H:%M') | $user" >> "$USER_HISTORY"
                echo "✅ $user disconnected."
              else
                echo "❌ Kick failed."
              fi
            else
              echo "Cancelled."
            fi
          fi
          ;;
        4)
          if [[ -n $ip ]] && (( pts > 0 )); then
            if occtl unban ip "$ip"; then
              echo "[unbanned] $(date '+%Y-%m-%d %H:%M') | $user | IP: $ip | cleared $pts points" >> "$USER_HISTORY"
              echo "✅ Ban points cleared ($ip)."
            else
              echo "❌ Unban failed."
            fi
          else
            echo "No ban points or user is not online."
          fi
          ;;
        0)
          exec "$0"
          ;;
        *)
          echo "Invalid choice."
          ;;
      esac
    else
      echo "Invalid choice."
    fi
    ;;
esac

read -rp "Press Enter to return to User Management Center..." _
exec "$0"
