# ocnames — shared helpers for ocservice scripts (sourced, not executed) — https://github.com/Ilyntiy/ocservice

NAME_RE='^[a-zA-Z0-9_-]+$'

pick_username() {
  local choice
  if [[ $NAMES_ENABLED != yes ]]; then
    _enter_manually
    return
  fi
  echo
  echo "  1 — Pick name from pool"
  echo "  2 — Enter manually"
  echo
  while true; do
    read -rp "Select option [1]: " choice
    case ${choice:-1} in
      1) _pick_from_pool; return ;;
      2) _enter_manually; return ;;
      *) echo "Please enter 1 or 2." ;;
    esac
  done
}

_build_used_set() {
  local crt name
  declare -gA _USED_SET=()
  if [[ -n $EASYRSA_DIR && -d $EASYRSA_DIR/pki/issued ]]; then
    for crt in "$EASYRSA_DIR"/pki/issued/*.crt; do
      [[ -f $crt ]] || continue
      name=${crt##*/}
      _USED_SET[${name%.crt}]=1
    done
  fi
  if [[ -n $USER_FILE && -f $USER_FILE ]]; then
    while IFS=: read -r name _; do
      [[ -n $name ]] && _USED_SET[$name]=1
    done < "$USER_FILE"
  fi
  if [[ -f $NAMES_USED_FILE ]]; then
    while IFS= read -r name; do
      name=${name//[$'\t\r ']}
      [[ -n $name && $name != \#* ]] && _USED_SET[$name]=1
    done < "$NAMES_USED_FILE"
  fi
}

_pick_from_pool() {
  local name all=() available=()
  if [[ ! -f $NAMES_FILE ]]; then
    echo "Name pool not found: $NAMES_FILE — falling back to manual entry."
    _enter_manually
    return
  fi
  _build_used_set
  while IFS= read -r name; do
    name=${name//[$'\t\r ']}
    [[ -n $name && $name != \#* ]] || continue
    if [[ ! $name =~ $NAME_RE ]]; then
      echo "Skipping invalid pool name: $name"
      continue
    fi
    all+=("$name")
  done < "$NAMES_FILE"

  for name in "${all[@]}"; do
    if [[ -z ${_USED_SET[$name]+x} ]]; then
      available+=("$name")
    elif ! grep -qxF -- "$name" "$NAMES_USED_FILE" 2>/dev/null; then
      echo "$name" >> "$NAMES_USED_FILE"
    fi
  done

  if (( ${#available[@]} == 0 )); then
    echo "No free names in the pool (add more to $NAMES_FILE) — falling back to manual entry."
    _enter_manually
    return
  fi

  USERNAME=${available[RANDOM % ${#available[@]}]}
  echo "$USERNAME" >> "$NAMES_USED_FILE"
  echo "Username: $USERNAME"
}

_enter_manually() {
  _build_used_set
  while true; do
    read -rp "Username: " USERNAME
    if [[ -z $USERNAME ]]; then
      echo "Error: username cannot be empty."
    elif [[ ! $USERNAME =~ $NAME_RE ]]; then
      echo "Error: allowed characters are letters, digits, - and _"
    elif [[ -n ${_USED_SET[$USERNAME]+x} ]]; then
      echo "Error: username '$USERNAME' is already taken."
    else
      break
    fi
  done
}

write_config_per_user() {
  local max_line="# max-same-clients = 0"
  [[ -n ${2:-} ]] && max_line="max-same-clients = $2"
  cat > "$CONFIG_PER_USER/$1" << EOF
# Per-user configuration file for ocserv
# Uncomment and set options as needed

$max_line

## Network

# Assign static IP address (use /30 subnet trick — set odd address, server uses next even)
# Uncomment both lines together
# ipv4-network = 10.18.18.0
# explicit-ipv4 = 10.18.18.X

## Transport

# Disable DTLS, force TCP only (useful for users behind UDP-blocking firewalls)
# no-udp = false

## Bandwidth

# Bandwidth limits in bytes/sec (0 = unlimited, 1048576 = 8 Mbit/s)
# rx-data-per-sec = 0
# tx-data-per-sec = 0

## Timeouts

# Idle timeout in seconds (0 = use global value)
# idle-timeout = 0
# mobile-idle-timeout = 0

# Maximum session duration in seconds (0 = unlimited)
# session-timeout = 0
EOF
}
