#!/bin/bash
# ocservice — ocserv admin menu — https://github.com/Ilyntiy/ocservice

DIR=$(dirname "$(realpath "$0")")
[[ -f $DIR/ocservice.conf ]] || { echo "Error: $DIR/ocservice.conf not found. Run install.sh first."; exit 1; }
# shellcheck source=/dev/null
source "$DIR/ocservice.conf"

EDITOR_CMD=${VISUAL:-${EDITOR:-$(command -v nano || command -v vi)}}
G=$'\033[0;32m'; Y=$'\033[0;33m'; R=$'\033[0;31m'; N=$'\033[0m'

occtl() { sudo -n "$OCCTL" -n "$@"; }
pause() { read -rp "Press Enter to return to menu..." _; }

openssl_read() {
  local file=$1
  shift
  if [[ -r $file ]]; then
    "$OPENSSL" "$@" -in "$file" 2>/dev/null
  else
    sudo -n "$OPENSSL" "$@" -in "$file" 2>/dev/null
  fi
}

expiry() {
  local end days color
  end=$(date -d "$1" +%Y-%m-%d 2>/dev/null) || { echo "n/a"; return 1; }
  days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
  if   (( days <= 10 )); then color=$R
  elif (( days <= 30 )); then color=$Y
  else                        color=$G
  fi
  printf '%sexpires in %s days (%s)%s' "$color" "$days" "$end" "$N"
  (( days > 30 ))
}

cert_line() {
  local raw
  [[ -n $SERVER_CERT ]] && raw=$(openssl_read "$SERVER_CERT" x509 -enddate -noout)
  if [[ -n $raw ]]; then expiry "${raw#*=}"; else echo "n/a"; fi
  echo
}

crl_line() {
  local raw
  if [[ -z ${CRL_FILE:-} ]]; then
    echo "${R}not configured — revoked certificates are accepted${N}"
    return
  fi
  raw=$(openssl_read "$CRL_FILE" crl -nextupdate -noout)
  raw=${raw#*=}
  if [[ -z $raw ]]; then echo "n/a"; return; fi
  if [[ $raw == NONE ]]; then echo "no expiry"; return; fi
  if ! expiry "$raw"; then
    echo
    echo "                       renew: cd $EASYRSA_DIR && ./easyrsa gen-crl, then 7 — Reload"
  else
    echo
  fi
}

status_block() {
  local raw status uptime active total failures banned rx tx la1 la2 la3 mem_total mem_avail
  raw=$(occtl show status 2>/dev/null)
  status=$(awk -F': ' '/^[[:space:]]*Status:/ {print $2}' <<< "$raw")
  uptime=$(grep 'Up since:' <<< "$raw" | sed -nE 's/.*\(\s*([^)]+)\).*/\1/p')
  active=$(awk -F': ' '/Active sessions:/ {print $2}' <<< "$raw")
  total=$(awk -F': ' '/Total sessions:/ {print $2}' <<< "$raw")
  failures=$(awk -F': ' '/Total authentication failures:/ {print $2}' <<< "$raw")
  banned=$(awk -F': ' '/IPs in ban list:/ {print $2}' <<< "$raw")
  rx=$(awk -F': ' '/^[[:space:]]*RX:/ {print $2}' <<< "$raw")
  tx=$(awk -F': ' '/^[[:space:]]*TX:/ {print $2}' <<< "$raw")
  if [[ $status == online ]]; then status="🟢 online"; else status="🔴 ${status:-unavailable}"; fi

  read -r la1 la2 la3 _ < /proc/loadavg
  mem_total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  mem_avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)

  echo "  ⚙️  Load:             $la1 / $la2 / $la3"
  awk -v u=$((mem_total - mem_avail)) -v t="$mem_total" 'BEGIN {printf "  💾 Memory:           %.1f GB / %.1f GB\n", u/1048576, t/1048576}'
  echo "  -----------------------------------------"
  echo "  Status:              $status"
  echo "  ⏱  Uptime:           $uptime"
  echo "  👥 Active sessions:  $active"
  echo "  📊 Total sessions:   $total"
  echo "  ❌ Auth failures:    $failures"
  echo "  🚫 Banned IPs:       $banned"
  echo "  📥 RX:               $rx"
  echo "  📤 TX:               $tx"
  echo "  🔐 Server cert:      $(cert_line)"
  [[ $AUTH_MODE != plain ]] && echo "  📜 CRL:              $(crl_line)"
}

show_menu() {
  clear
  echo "==========================================="
  echo "       🔐 $SERVER_NAME — ocserv Tool"
  echo "==========================================="
  status_block
  echo "==========================================="
  echo "📋 Users:"
  [[ $AUTH_MODE != plain ]] && echo "  1 — Create certificate user"
  [[ $AUTH_MODE != cert  ]] && echo "  2 — Create login/password user"
  echo "  3 — User Management Center"
  echo "-------------------------------------------"
  echo "⚙️  Service:"
  echo "  4 — View ocserv log"
  echo "  5 — Edit ocserv.conf (sudo password required)"
  echo "  6 — Restart ocserv"
  echo "  7 — Reload configuration"
  echo "  8 — Active connections"
  [[ $NAMES_ENABLED == yes ]] && echo "  9 — Edit name pool"
  echo "  q — Quit"
  echo "==========================================="
  read -rp "Enter action: " ACTION
}

while true; do
  show_menu
  case $ACTION in
    q)
      echo "Bye."
      exit 0
      ;;
    1)
      if [[ $AUTH_MODE == plain ]]; then
        echo "Certificate auth is disabled (AUTH_MODE=plain)."; pause
      else
        "$DIR/gen-client"
      fi
      ;;
    2)
      if [[ $AUTH_MODE == cert ]]; then
        echo "Password auth is disabled (AUTH_MODE=cert)."; pause
      else
        "$DIR/gen-login"
      fi
      ;;
    3)
      "$DIR/user-center"
      ;;
    4)
      echo "Last 200 lines, following (Ctrl+C to return):"
      trap ':' INT
      journalctl -u ocserv -n 200 -f
      trap - INT
      ;;
    5)
      before=$(stat -c %Y -- "$OCSERV_CONF" 2>/dev/null)
      SUDO_EDITOR=$EDITOR_CMD sudoedit "$OCSERV_CONF"
      if [[ $(stat -c %Y -- "$OCSERV_CONF" 2>/dev/null) != "$before" ]]; then
        echo "ocserv.conf changed. Apply: 7 — Reload, or 6 — Restart for auth, ports and certificates."
      fi
      pause
      ;;
    6)
      if sudo -n "$SYSTEMCTL" restart ocserv; then echo "✅ ocserv restarted."; else echo "❌ Restart failed."; fi
      pause
      ;;
    7)
      if occtl reload; then echo "✅ Configuration reloaded."; else echo "❌ Reload failed."; fi
      pause
      ;;
    8)
      occtl show users
      pause
      ;;
    9)
      if [[ $NAMES_ENABLED != yes ]]; then
        echo "Name pool is disabled (NAMES_ENABLED=no)."; pause
      else
        "$EDITOR_CMD" "$NAMES_FILE"
      fi
      ;;
    *)
      echo "Invalid choice."; pause
      ;;
  esac
done
